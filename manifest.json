{
  "manifest_version": 3,
  "name": "Youtube Element Remover",
  "version": "1.4",
  "description": "Hides distracting sidebar, recommendation, homepage video, and Shorts sections on YouTube.",
  "permissions": ["storage"],
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_title": "Youtube Element Remover",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "css": ["styles.css"],
      "js": ["scripts/content.js"],
      "run_at": "document_start"
    }
  ]
}
